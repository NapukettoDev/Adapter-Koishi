{
    // fallow 配置：本仓库专用。只豁免已确认的误报源、框架契约与有意设计，
    // 不放松重复与复杂度阈值。
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
    // 动态加载入口：client/ 是控制台前端，经 src/bot/utils/console-entry.ts 的
    // ctx.console.addEntry 动态注册，静态分析看不到引用——标记为动态入口。
    "dynamicallyLoaded": [
        "client/**"
    ],
    // 顶层规则豁免：当前 @napuketto/* 均为 dependencies，且 tsdown 用
    // deps.bundle: false 保持 external（子进程要读磁盘上的 self-host.cjs /
    // stub DLL / kernel 入口，bundle 会丢资产）。本规则保留为构建期依赖的兜底豁免。
    "rules": {
        "dev-dependencies-in-production": "off"
    },
    // koishi 框架契约豁免（overrides 按文件精准关闭，保留文件内其他 finding）：
    //  - src/bot/bot.ts：NapukettoBot 全部 override 方法是 koishi Bot 接口实现
    //    （start/stop/getMessageList/getLogin/getFriendList/getChannel/... 框架多态
    //    调用）+ MessageEncoder static（koishi 按 bot.constructor.MessageEncoder
    //    反射查找），静态分析无引用
    //  - src/ipc/client.ts：alive/sendControl 被 driver.ts 经「null 联合类型 +
    //    属性访问」调用（stop() 里 current.alive / current.sendControl），
    //    fallow 流分析漏报（实际有消费者）
    //  - src/driver/driver.ts：restartAttempts 是测试断言（driver-restart.test.ts）
    //    + 诊断用公共 getter
    //  - src/console/provider.ts：NapukettoLoginProvider.get 是 DataService 抽象
    //    方法实现（koishi 控制台 PULL 路径框架调用），fallow 继承感知只覆盖
    //    同仓库 extends 链，跨包基类（@koishijs/plugin-console）分析不到
    "overrides": [
        {
            "files": [
                "src/bot/bot.ts",
                "src/ipc/client.ts",
                "src/driver/driver.ts",
                "src/console/provider.ts"
            ],
            "rules": {
                "unused-class-members": "off"
            }
        }
    ],
    // 公共 API 面豁免：
    //  - src/login/index.ts：LoginObserver/LoginSnapshot/LoginView 是登录交互公共
    //    类型（LoginView 供控制台与测试注入；见 docs/architecture/lifecycle.md）
    "ignoreFindings": [
        "src/login/index.ts"
    ],
    // class + namespace 声明合并（bot.ts `export class NapukettoBot` + 文件尾
    // `export namespace NapukettoBot`，napcat 同构模式：Config 常量/类型合并到类
    // 上）——fallow 误判 duplicate-export，按导出名精准豁免。
    "ignoreExports": [
        {
            "file": "src/bot/bot.ts",
            "exports": [
                "NapukettoBot"
            ]
        }
    ]
}