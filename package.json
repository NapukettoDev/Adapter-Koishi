{
    "name": "koishi-plugin-adapter-napuketto",
    "version": "0.0.35",
    "description": "NapukettoQQ内嵌到Koishi的适配器：让Koishi直接驱动NapukettoQQ",
    "contributors": [
        "Oppenheymu <oppenheymu@gmail.com>"
    ],
    "type": "module",
    "main": "lib/index.cjs",
    "types": "lib/index.d.cts",
    "exports": {
        ".": {
            "types": "./lib/index.d.cts",
            "development": "./src/index.ts",
            "default": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "client",
        "dist"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://github.com/Oppenheymu/koishi-plugin-adapter-napuketto",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Oppenheymu/koishi-plugin-adapter-napuketto.git"
    },
    "keywords": [
        "chatbot",
        "koishi",
        "plugin",
        "adapter",
        "qq",
        "napuketto"
    ],
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "build:client": "node scripts/build-client.ts",
        "lint:client": "eslint \"client/**/*.vue\"",
        "check": "biome check . && tsc --noEmit && tsc --noEmit -p client/tsconfig.json && eslint \"client/**/*.vue\""
    },
    "dependencies": {
        "@napuketto/adapter": "~0.3.2",
        "@napuketto/kernel": "~0.2.0",
        "@napuketto/loader": "~0.0.35",
        "@napuketto/media": "~0.0.5",
        "@napuketto/network": "~0.0.2"
    },
    "peerDependencies": {
        "koishi": "^4.18.7",
        "@koishijs/plugin-console": "^5.30.11"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@koishijs/client": "^5.29.4",
        "@koishijs/plugin-console": "^5.30.11",
        "@satorijs/core": "^4.6.0",
        "@types/node": "^26.1.2",
        "@typescript-eslint/parser": "^8.67.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "eslint": "^10.8.1",
        "eslint-plugin-vue": "^10.10.0",
        "koishi": "4.18.11",
        "tsdown": "^0.22.14",
        "typescript": "^7.0.2",
        "vite": "^8.2.1",
        "vitest": "^4.1.10",
        "vue": "^3.5.12",
        "vue-eslint-parser": "^10.4.1"
    },
    "koishi": {
        "category": "adapter",
        "description": {
            "en": "NapukettoQQ adapter for Koishi: drive QQ via the self-developed wrapper.node protocol layer",
            "zh": "NapukettoQQ 适配器：自研 QQ NT wrapper.node 协议层，无需 NapCat"
        }
    }
}