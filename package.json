{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "koishi-plugin-adapter-napuketto",
    "version": "0.0.67",
    "description": "Napuketto 内嵌到 Koishi 的适配器：让 Koishi 直接驱动 Napuketto",
    "keywords": [
        "chatbot",
        "koishi",
        "plugin",
        "adapter",
        "qq",
        "napuketto"
    ],
    "homepage": "https://github.com/NapukettoDev/Adapter-Koishi",
    "bugs": {
        "url": "https://github.com/NapukettoDev/Adapter-Koishi/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NapukettoDev/Adapter-Koishi.git"
    },
    "license": "MIT",
    "author": {
        "name": "Oppenheymu",
        "email": "oppenheymu@gmail.com",
        "url": "https://github.com/Oppenheymu"
    },
    "contributors": [
        "Oppenheymu <oppenheymu@gmail.com>"
    ],
    "packageManager": "pnpm@12.4.1",
    "engines": {
        "node": ">=22.12.0",
        "pnpm": ">=12.0.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "lib",
        "client",
        "dist"
    ],
    "type": "module",
    "main": "lib/index.cjs",
    "types": "lib/index.d.cts",
    "exports": {
        ".": {
            "types": "./lib/index.d.cts",
            "development": "./src/index.ts",
            "default": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "build:client": "vite build --config vite.config.client.ts",
        "check": "biome check . && tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
        "dev": "tsdown --watch",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@napuketto/adapter": "0.24.2",
        "@napuketto/kernel": "0.19.3",
        "@napuketto/loader": "0.16.1",
        "@napuketto/media": "0.4.1",
        "@napuketto/network": "0.5.1"
    },
    "peerDependencies": {
        "koishi": "^4.18.11",
        "@koishijs/plugin-console": "^5.30.11"
    },
    "devDependencies": {
        "koishi": "4.18.11",
        "@koishijs/plugin-console": "^5.30.11",
        "vue": "^3.5.12",
        "vite": "^8.2.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "typescript": "^7.0.2",
        "@types/node": "^26.1.2",
        "tsdown": "^0.23.7",
        "vitest": "^5.1.1",
        "@biomejs/biome": "^2.5.6"
    },
    "koishi": {
        "description": {
            "zh": "Napuketto 适配器，无需外部协议端",
            "en": "Napuketto adapter for Koishi, no external protocol required"
        },
        "service": {
            "optional": [
                "database"
            ],
            "implements": [
                "adapter"
            ]
        }
    }
}
