{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "koishi-plugin-adapter-napuketto",
    "version": "0.0.40",
    "description": "NapukettoQQ内嵌到Koishi的适配器：让Koishi直接驱动NapukettoQQ",
    "keywords": [
        "chatbot",
        "koishi",
        "plugin",
        "adapter",
        "qq",
        "napuketto"
    ],
    "homepage": "https://github.com/NapukettoDev/Adapter-Koishi",
    "bugs": {
        "url": "https://github.com/NapukettoDev/Adapter-Koishi/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NapukettoDev/Adapter-Koishi.git"
    },
    "license": "MIT",
    "author": {
        "name": "Oppenheymu",
        "email": "oppenheymu@gmail.com",
        "url": "https://github.com/Oppenheymu"
    },
    "contributors": [
        "Oppenheymu <oppenheymu@gmail.com>"
    ],
    "packageManager": "pnpm@12.4.1",
    "engines": {
        "node": ">=22.12.0",
        "pnpm": ">=12.0.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "lib",
        "client",
        "dist"
    ],
    "type": "module",
    "main": "lib/index.cjs",
    "types": "lib/index.d.cts",
    "exports": {
        ".": {
            "types": "./lib/index.d.cts",
            "development": "./src/index.ts",
            "default": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "build:client": "vite build --config vite.config.client.ts",
        "check": "biome check . && tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
        "dev": "tsdown --watch",
        "lint:client": "eslint \"client/**/*.vue\"",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@napuketto/adapter": "~0.18.20",
        "@napuketto/kernel": "~0.16.3",
        "@napuketto/loader": "~0.10.8",
        "@napuketto/media": "~0.2.2",
        "@napuketto/network": "~0.4.5"
    },
    "peerDependencies": {
        "koishi": "^4.18.11",
        "@koishijs/plugin-console": "^5.30.11"
    },
    "devDependencies": {
        "koishi": "4.18.11",
        "@satorijs/core": "^4.6.0",
        "@koishijs/plugin-console": "^5.30.11",
        "@koishijs/client": "^5.29.4",
        "vue": "^3.5.12",
        "vite": "^8.2.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "typescript": "^7.0.2",
        "@types/node": "^26.1.2",
        "tsdown": "^0.23.7",
        "vitest": "^5.1.1",
        "@biomejs/biome": "^2.5.6",
        "eslint": "^10.8.1",
        "eslint-plugin-vue": "^10.10.0",
        "vue-eslint-parser": "^10.4.1",
        "@typescript-eslint/parser": "^8.67.0"
    },
    "koishi": {
        "category": "adapter",
        "description": {
            "en": "NapukettoQQ adapter for Koishi: drive QQ via the self-developed wrapper.node protocol layer",
            "zh": "NapukettoQQ 适配器：自研 QQ NT wrapper.node 协议层，无需外部协议端"
        }
    }
}
